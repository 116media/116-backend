# postgres config
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=5432

# user seed config
DEFAULT_USER_PASSWORD=

# jwt config
JWT_SECRET=your-super-secret-jwt-key-that-is-at-least-32-characters-long-for-production
JWT_ISSUER=116_frontend
JWT_AUDIENCE=116_client
JWT_ACCESS_TOKEN_EXPIRATION=60
JWT_REFRESH_TOKEN_EXPIRATION=43200
# Absolute session lifetime in days; refreshes cannot slide a session past this ceiling
JWT_SESSION_ABSOLUTE_LIFETIME_IN_DAYS=30

# ASP.NET Core environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

# CORS origins (for cookie-based token delivery)
DASHBOARD_ORIGIN=http://localhost:5173,http://localhost:4173
WEBAPP_ORIGIN=http://localhost:3000

# Cloudinary configuration (for file uploads)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Social login (verified provider tokens)
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Odesli (song.link) streaming-link resolution
# The API is keyless on the free tier; the key only raises the rate limit.
ODESLI_API_URL=https://api.song.link/v1-alpha.1
ODESLI_API_KEY=

# Email delivery (Mailer module)
# EMAIL_PROVIDER selects the adapter: smtp (default, Mailpit in dev) or resend
EMAIL_PROVIDER=smtp
EMAIL_FROM_ADDRESS=no-reply@116.example
EMAIL_FROM_NAME=116
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_STARTTLS=false
RESEND_API_KEY=

# Public frontend base URL (links embedded in emails)
FRONTEND_BASE_URL=http://localhost:3000

# Trusted reverse-proxy networks (comma-separated CIDR). Leave empty for direct connections.
TRUSTED_PROXY_NETWORKS=
