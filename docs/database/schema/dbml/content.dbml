  "category_id" uuid [not null]
  "author_id" uuid [not null]
  "title" varchar(100) [not null, unique]
  "slug" varchar(220) [not null, unique]
  "description" text [not null]
  "social_boost" boolean [not null, default: false]
  "is_promoted" boolean [not null, default: false]
  "unpromoted_at" timestamptz
  "has_lyrics" boolean [not null, default: false]
  "status" text [not null, default: `'Draft'`]
  "rejection_reason" varchar(500)
  "shooting_scheduled_at" timestamptz
  "published_at" timestamptz
  "meta_title" varchar(70)
  "meta_description" varchar(160)
  "rating_average" numeric(3,2) [not null, default: 0.0]
  "rating_count" integer [not null, default: 0]
  "share_count" integer [not null, default: 0]
  "created_at" timestamptz
  "created_by" text
  "updated_at" timestamptz
  "updated_by" text
  "youtube_video_url" varchar(200)
  "promoted_until" timestamptz
  "unpromoted_by" text
  "unpromoted_reason" varchar(500)
  "promotion_level_id" uuid
  "thumbnail_file_id" uuid
  "artist_id" uuid
  Indexes {
    ("artist_id", "status")
    ("status", "published_at")
  }
}

