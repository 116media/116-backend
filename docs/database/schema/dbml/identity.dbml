Table "identity"."domain_event_outbox" {
  "id" uuid [pk]
  "event_type" varchar(500) [not null]
  "payload" text [not null]
  "occurred_on" timestamptz [not null]
  "dispatched_at" timestamptz
  "attempt_count" integer [not null, default: 0]
  "last_error" text
}

Table "identity"."otps" {
  "id" uuid [pk]
  "user_id" uuid [not null]
  "code_hash" varchar(100) [not null]
  "purpose" text [not null]
  "expires_at" timestamptz [not null]
  "attempt_count" integer [not null, default: 0]
  "is_used" boolean [not null, default: false]
  "used_at" timestamptz
  "created_at" timestamptz
  "created_by" text
  "updated_at" timestamptz
  "updated_by" text
  "consumed_at" timestamptz
  Indexes {
    ("purpose", "expires_at")
    ("user_id", "purpose")
  }
}

Table "identity"."permissions" {
  "id" uuid [pk]
  "resource" varchar(15) [not null]
  "action" varchar(15) [not null]
  "description" varchar(300) [not null]
  "created_at" timestamptz
  "created_by" text
  "updated_at" timestamptz
  "updated_by" text
  "deleted_at" timestamptz
  "is_active" boolean [not null, default: true]
  "is_deleted" boolean [not null, default: false]
  Indexes {
    ("resource", "action") [unique]
  }
}

Table "identity"."role_permissions" {
  "id" uuid [pk]
  "role_id" uuid [not null]
  "permission_id" uuid [not null]
  "created_at" timestamptz
  "created_by" text
  "updated_at" timestamptz
  "updated_by" text
  Indexes {
    ("role_id", "permission_id") [unique]
  }
}

Table "identity"."roles" {
  "id" uuid [pk]
  "name" varchar(20) [not null, unique]
  "description" varchar(300) [not null]
  "created_at" timestamptz
  "created_by" text
  "updated_at" timestamptz
  "updated_by" text
  "deleted_at" timestamptz
  "is_active" boolean [not null, default: true]
  "is_deleted" boolean [not null, default: false]
}

Table "identity"."sessions" {
  "id" uuid [pk]
  "user_id" uuid [not null]
  "device_id" varchar(64) [not null]
  "refresh_token_hash" varchar(500) [not null]
  "expires_at" timestamptz [not null]
  "ip_address" varchar(45)
  "user_agent" varchar(500)
  "browser" text [not null]
  "device" text [not null]
  "platform" text [not null]
  "client" text [not null]
  "is_revoked" boolean [not null, default: false]
  "revoked_at" timestamptz
  "created_at" timestamptz [not null]
  "created_by" text
  "updated_at" timestamptz
  "updated_by" text
  "absolute_expires_at" timestamptz [not null, default: `'-infinity'`]
  Indexes {
    ("user_id", "device_id")
  }
}

Table "identity"."user_login_state" {
  "user_id" uuid [pk]
  "failed_attempts" integer [not null, default: 0]
  "locked_until" timestamptz
  "created_at" timestamptz
  "created_by" text
  "updated_at" timestamptz
  "updated_by" text
}

Table "identity"."user_otp_state" {
  "user_id" uuid [pk]
  "failed_attempts" integer [not null, default: 0]
  "locked_until" timestamptz
  "created_at" timestamptz
  "created_by" text
  "updated_at" timestamptz
  "updated_by" text
}

Table "identity"."user_roles" {
  "id" uuid [pk]
