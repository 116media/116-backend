  "role_id" uuid [not null]
  "created_at" timestamptz
  "created_by" text
  "updated_at" timestamptz
  "updated_by" text
  Indexes {
    ("user_id", "role_id") [unique]
  }
}

Table "identity"."user_token_state" {
  "user_id" uuid [pk]
  "security_stamp" uuid [not null]
  "token_version" bigint [not null, default: 0]
  "created_at" timestamptz
  "created_by" text
  "updated_at" timestamptz
  "updated_by" text
}

Table "identity"."users" {
  "id" uuid [pk]
  "email" varchar(254) [unique]
  "user_name" varchar(20) [not null, unique]
  "password_hash" text
  "auth_provider" text [not null]
  "is_verified" boolean [not null, default: false]
  "is_active" boolean [not null, default: true]
  "avatar_file_id" uuid
  "avatar_source" text [not null]
  "country_name" varchar(100)
  "country_iso_code" varchar(3)
  "country_dial_code" varchar(10)
  "partial_phone_number" varchar(50)
  "full_phone_number" varchar(20)
  "created_at" timestamptz
  "created_by" text
  "updated_at" timestamptz
  "updated_by" text
  "provider_subject_id" varchar(255)
  Indexes {
    ("auth_provider", "provider_subject_id")
  }
}

