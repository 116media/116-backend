// mailer schema — final applied state, generated from applied-full.sql.
// This is DBML: paste it directly into the dbdiagram.io editor pane.

Table "mailer"."domain_event_outbox" {
  "id" uuid [pk]
  "event_type" varchar(500) [not null]
  "payload" text [not null]
  "occurred_on" timestamptz [not null]
  "dispatched_at" timestamptz
  "attempt_count" integer [not null, default: 0]
  "last_error" text
}

Table "mailer"."newsletter_subscribers" {
  "id" uuid [pk]
  "email" varchar(320) [not null, unique]
  "status" varchar(30) [not null]
  "confirmation_token" varchar(64) [not null, unique]
  "unsubscribe_token" varchar(64) [not null, unique]
  "confirmed_at" timestamptz
  "unsubscribed_at" timestamptz
  "created_at" timestamptz
  "created_by" text
  "updated_at" timestamptz
  "updated_by" text
}

Table "mailer"."notifications" {
  "id" uuid [pk]
  "user_id" uuid [not null]
  "type" varchar(50) [not null]
  "title" varchar(200) [not null]
  "body" varchar(500) [not null]
  "link_path" varchar(300)
  "read_at" timestamptz
  "created_at" timestamptz
  "created_by" text
  "updated_at" timestamptz
  "updated_by" text
  Indexes {
    ("user_id", "created_at")
    ("user_id", "read_at")
  }
}

Table "mailer"."outbox_emails" {
  "id" uuid [pk]
  "recipient_address" varchar(320) [not null]
  "recipient_name" varchar(200)
  "subject" varchar(500) [not null]
  "html_body" text [not null]
  "text_body" text [not null]
  "template" varchar(100) [not null]
  "status" varchar(20) [not null]
  "attempt_count" integer [not null]
  "next_attempt_at" timestamptz [not null]
  "last_error" varchar(1000)
  "sent_at" timestamptz
  "created_at" timestamptz
  "created_by" text
  "updated_at" timestamptz
  "updated_by" text
  "lease_expires_at" timestamptz
  Indexes {
    ("status", "next_attempt_at")
  }
}

