{
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "if": "Bash(git commit*)",
                        "command": "H=\"${CLAUDE_PROJECT_DIR:-.}/scripts/ai-precheck-hook.sh\"; [ -r \"$H\" ] || exit 0; bash \"$H\" commit",
                        "timeout": 180,
                        "statusMessage": "Running the pre-commit gate (format, CRAP, vulnerable packages)"
                    }
                ]
            }
        ],
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "H=\"${CLAUDE_PROJECT_DIR:-.}/scripts/ai-precheck-hook.sh\"; [ -r \"$H\" ] || exit 0; bash \"$H\" edit",
                        "timeout": 60,
                        "statusMessage": "Measuring CRAP on the edited file"
                    }
                ]
            }
        ]
    }
}
