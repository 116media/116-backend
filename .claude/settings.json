{
    "hooks": {
        "PostToolUse": [
            {
                "matcher": "Write|Edit",
                "hooks": [
                    {
                        "type": "command",
                        "command": "H=\"${CLAUDE_PROJECT_DIR:-.}/scripts/ai-precheck-hook.sh\"; [ -r \"$H\" ] || exit 0; bash \"$H\" edit",
                        "timeout": 60,
                        "statusMessage": "Measuring CRAP on the edited file"
                    }
                ]
            }
        ]
    }
}
