#!/bin/bash

# Pre-push hook to enforce branch protection and naming conventions
# This hook prevents direct pushes to protected branches and validates branch naming

protected_branches="main develop master"
branch_pattern="^(feat|chore|bug|fix|doc|docs|style|refactor|perf|test|build|ci|revert)-[a-z]+(-[a-z]+)*$"

# Get current branch name
current_branch=$(git rev-parse --abbrev-ref HEAD)

# Colors for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo -e "${GREEN}🔍 Validating branch protection rules...${NC}"

# Check if trying to push to a protected branch
for protected in $protected_branches; do
    if [ "$current_branch" = "$protected" ]; then
        echo -e "${RED}❌ ERROR: Direct push to '$protected' branch is not allowed!${NC}"
        echo -e "${YELLOW}📋 Please create a feature branch following this pattern:${NC}"
        echo "   $branch_pattern"
        echo ""
        echo -e "${YELLOW}📝 Example branch names:${NC}"
        echo "   • feat-user-authentication"
        echo "   • fix-api-response-validation"
        echo "   • chore-update-dependencies"
        echo "   • docs-git-workflow"
        echo ""
        echo -e "${YELLOW}💡 To create and switch to a new branch:${NC}"
        echo "   git checkout -b feat-your-feature-name"
        echo ""
        exit 1
    fi
done

# Validate branch naming convention (skip for protected branches during merges)
if ! echo "$current_branch" | grep -qE "$branch_pattern"; then
    # Allow temporary branches like PR merge branches
    if echo "$current_branch" | grep -qE "^(HEAD|refs/)"; then
        echo -e "${GREEN}✅ Temporary branch detected, skipping naming validation${NC}"
    else
        echo -e "${RED}❌ ERROR: Branch name '$current_branch' does not follow the required pattern!${NC}"
        echo -e "${YELLOW}📋 Required pattern:${NC}"
        echo "   $branch_pattern"
        echo ""
        echo -e "${YELLOW}📝 Valid branch types:${NC}"
        echo "   • feat-    : New features or functionality"
        echo "   • chore-   : Maintenance tasks, dependency updates"
        echo "   • bug-     : Bug fixes and issue resolution"
        echo "   • fix-     : General fixes and corrections"
        echo "   • doc-/docs-: Documentation updates"
        echo "   • style-   : Code style, formatting changes"
        echo "   • refactor-: Code refactoring without functionality changes"
        echo "   • perf-    : Performance improvements"
        echo "   • test-    : Test additions or modifications"
        echo "   • build-   : Build system or deployment changes"
        echo "   • ci-      : Continuous integration configuration"
        echo "   • revert-  : Reverting previous changes"
        echo ""
        echo -e "${YELLOW}💡 To rename your current branch:${NC}"
        echo "   git branch -m new-branch-name"
        echo ""
        exit 1
    fi
fi

echo -e "${GREEN}✅ Branch validation passed! Proceeding with push...${NC}"
exit 0
