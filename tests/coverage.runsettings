<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat Code Coverage">
                <Configuration>
                    <Format>opencover,cobertura</Format>
                    <Exclude>[*Tests*]*,[*Migrations*]*,[Fixtures]*,[TestData]*,[*.TestData]*</Exclude>
                    <!--
                        CompilerGeneratedAttribute is deliberately absent: an async method
                        body compiles into a generated state machine, so excluding it hid
                        every async method from the report. CRAP then read them as
                        uncovered and flagged well-tested handlers.
                    -->
                    <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute</ExcludeByAttribute>
                    <ExcludeByFile>**/Migrations/*.cs,**/*.Designer.cs</ExcludeByFile>
                    <SingleHit>false</SingleHit>
                    <UseSourceLink>true</UseSourceLink>
                    <IncludeTestAssembly>false</IncludeTestAssembly>
                    <SkipAutoProps>true</SkipAutoProps>
                    <DeterministicReport>false</DeterministicReport>
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
    <RunConfiguration>
        <MaxCpuCount>0</MaxCpuCount>
        <ResultsDirectory>./TestResults</ResultsDirectory>
        <TargetFrameworkVersion>net9.0</TargetFrameworkVersion>
        <TestSessionTimeout>600000</TestSessionTimeout>
    </RunConfiguration>
    <LoggerRunSettings>
        <Loggers>
            <Logger friendlyName="trx" enabled="true">
                <Configuration>
                    <LogFileName>test-results.trx</LogFileName>
                </Configuration>
            </Logger>
            <Logger friendlyName="console" enabled="true">
                <Configuration>
                    <Verbosity>normal</Verbosity>
                </Configuration>
            </Logger>
        </Loggers>
    </LoggerRunSettings>
</RunSettings>
