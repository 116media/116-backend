<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
        <!-- Suppress xUnit1051: Use TestContext.Current.CancellationToken - not critical for unit tests -->
        <NoWarn>$(NoWarn);xUnit1051</NoWarn>
    </PropertyGroup>

    <PropertyGroup>
        <RootNamespace>_116.Unit.Tests</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
        <!-- Test Framework -->
        <PackageReference Include="EFCore.NamingConventions" />
        <PackageReference Include="xunit.v3" />
        <PackageReference Include="xunit.runner.visualstudio" VersionOverride="3.0.2">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.NET.Test.Sdk" />

        <!-- Assertions -->
        <PackageReference Include="AwesomeAssertions" />
        <PackageReference Include="AwesomeAssertions.Analyzers">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>

        <!-- Mocking -->
        <PackageReference Include="Moq" />
        <PackageReference Include="Polly.Core" />
        <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" />

        <!-- Data Generation -->
        <PackageReference Include="Bogus" />

        <!-- Testing -->
        <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />

        <!-- Coverage -->
        <PackageReference Include="coverlet.msbuild">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
        <PackageReference Include="coverlet.collector">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Modules\Identity\Identity\Identity.csproj" />
        <ProjectReference Include="..\..\src\Modules\Core\Core\Core.csproj" />
        <ProjectReference Include="..\..\src\Modules\Content\Content\Content.csproj" />
        <ProjectReference Include="..\..\src\Modules\Mailer\Mailer\Mailer.csproj" />
        <ProjectReference Include="..\..\src\Shared\Shared\Shared.csproj" />
        <ProjectReference Include="..\..\src\Shared\Shared.Contracts\Shared.Contracts.csproj" />
        <ProjectReference Include="..\..\src\BuildingBlocks\BuildingBlocks.csproj" />
        <ProjectReference Include="..\Fixtures\_116.Tests.Fixtures.csproj" />
    </ItemGroup>
</Project>
